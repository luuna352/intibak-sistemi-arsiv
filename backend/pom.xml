<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Spring Boot'un ortak ayarları ve bağımlılık sürümleri buradan gelir; aşağıda sürüm yazmamız gerekmez. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>tr.edu.yalova</groupId>
	<artifactId>intibak-sistemi</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>intibak-sistemi</name>
	<description>Yalova Üniversitesi intibak komisyonu uygulaması (backend)</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- REST endpoint'leri (Spring MVC + gömülü Tomcat + JSON) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Gelen isteklerdeki alanların kontrolü (@NotBlank, @Size ...) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Veritabanı erişimi: JPA (Hibernate) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Şema değişiklikleri: Flyway, db/migration altındaki V*.sql dosyalarını sırayla çalıştırır -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- Giriş, session ve CSRF koruması -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Excel (.xlsx) okuma/yazma: ders planı yükleme ve boş şablon indirme -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
		</dependency>
		<!-- PDF'ten yazı çıkarma: ders içerik belgeleri (A2-A3). DOCX için yukarıdaki poi-ooxml kullanılır. -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.7</version>
		</dependency>
		<!-- PostgreSQL JDBC sürücüsü: sadece çalışırken gerekir -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Testler: MockMvc ile controller testi (veritabanı gerektirmez) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testlerde CSRF token'ı ve giriş yapmış kullanıcı taklidi (csrf(), user()) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- mvnw spring-boot:run ile çalıştırma ve tek jar paketleme -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
